# jykj_ocr 环境变量示例
# 复制为 .env 并填入真实值：  cp .env.example .env
# .env 已在 .gitignore 中，不会被提交。
#
# 远程 OCR 引擎统一走 OpenAI 兼容协议：只需设置下面这一对变量，
# 即可指向任意平台（硅基流动 / 阿里云百炼 / 智谱 / 本地 vLLM 等）。
# siliconflow 引擎在不设这对变量时仍会用其内置默认 URL，无需额外配置。

# === 首选：通用 OpenAI 兼容端点（适配任意平台） ===
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# 其他平台示例：
#   阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱：       https://open.bigmodel.cn/api/paas/v4
#   本地 vLLM：  http://localhost:8000/v1

# === 可选：引擎专属变量（覆盖优先级高于 OPENAI_*） ===
# 仅当某一引擎需要与 OPENAI_* 不同的 key/URL 时才设：
# SILICONFLOW_API_KEY=sk-your-siliconflow-key

# === 服务配置 ===
# JYKJ_OCR_CONFIG=config/config.yaml
# JYKJ_OCR_PORT=8000
